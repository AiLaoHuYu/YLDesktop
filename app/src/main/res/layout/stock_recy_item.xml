<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/stock_item_parent"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dimens100"
    android:layout_marginTop="@dimen/dimens5"
    android:layout_marginBottom="@dimen/dimens5"
    android:background="@drawable/stock_ups_bg"
    android:orientation="horizontal">

    <androidx.cardview.widget.CardView
        android:id="@+id/stock_item_image_card"
        android:layout_width="@dimen/dimens70"
        android:layout_height="@dimen/dimens70"
        android:layout_marginStart="@dimen/dimens30"
        app:cardCornerRadius="@dimen/dimens20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/stock_item_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:src="@drawable/apple" />

    </androidx.cardview.widget.CardView>


    <TextView
        android:id="@+id/stock_item_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimens10"
        android:layout_marginTop="@dimen/dimens10"
        android:text="Apple"
        android:textColor="@color/black"
        android:textSize="18sp"
        app:layout_constraintStart_toEndOf="@id/stock_item_image_card"
        app:layout_constraintTop_toTopOf="@id/stock_item_image_card" />

    <TextView
        android:id="@+id/stock_item_ups_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimens13"
        android:text="(6.71%)"
        android:textColor="@color/blue"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@id/stock_item_image_card"
        app:layout_constraintTop_toBottomOf="@id/stock_item_name" />


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/stock_item_bg"
        android:padding="@dimen/dimens5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="@dimen/dimens10">

        <ImageView
            android:id="@+id/stock_image_ups_or_downs"
            android:layout_width="@dimen/dimens10"
            android:layout_height="@dimen/dimens10"
            android:layout_gravity="center"
            android:src="@drawable/ups" />

        <TextView
            android:id="@+id/stock_item_ups_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/dimens5"
            android:text="$6,750"
            android:textColor="@color/black" />


    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>